{% extends 'base.html.twig' %}

{% block title %}Accueil
{% endblock %}

{% block body %}

	{% set sectionHeroClass = "relative px-6 sm:px-0 md:px-[93px] bg-[#D3DCEB]
	pt-[120px] pb-[42px] bg-cover bg-center bg-no-repeat
	min-h-screen flex items-center" %}

	<section
		class="{{ sectionHeroClass }}" style="background-image: url('{{ asset('images/backgrounds/image-cover.jpg') }}')">

		{# Bloc principal (accroche, CTA, etc.) #}
		{% include '_partials/main/bloc.html.twig' %}

	</section>

	{# === Liste des tricks de l'utilisateur === #}
	{% include '_partials/main/tricks/section.html.twig' %}

	{# === Scroll to top / UX === #}
	{% include '_partials/scroll.html.twig' %}

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/load.js') }}"></script>
	<script src="{{ asset('js/scroll.js') }}"></script>
{% endblock %}
