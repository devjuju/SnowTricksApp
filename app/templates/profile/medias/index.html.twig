{% extends 'base.html.twig' %}

{% block title %}Ajouter des medias au trick
{% endblock %}

{% block body %}
	<section
		class="relative bg-[#979EAB] pb-12">

		{# === Hero de la page === #}
		{% include '_partials/trick/hero.html.twig' %}

		<div
			class="relative z-10 container mx-auto px-4 sm:px-6 md:px-12 lg:px-20 xl:px-32 pt-20 ">
			{# === Conteneur principal du formulaire === #}
			<div class="bg-white rounded-xl shadow-lg max-w-6xl mx-auto overflow-hidden pb-[42px]">

				{% include '_partials/trick/details/featured_image.html.twig' %}

				{# === Messages flash (succès, erreur, etc.) === #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="p-4 mb-4 rounded bg-green-100 text-green-800">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}

				{{ form_start(form, { attr: { novalidate:'novalidate', enctype:'multipart/form-data' } }) }}

				{# Gestion des médias (images + vidéos dynamiques) #}
				{% include '_partials/trick/add/media.html.twig' %}

				<div class="px-4 md:px-8">
					<div class="flex flex-col justify-end md:flex-row md:justify-end mt-4 gap-4 mb-8">
						<a href="{{ path('app_profile_tricks_edit', {slug: trick.slug}) }}" class="bg-[#f8285a] text-white px-6 py-3 rounded-2xl hover:bg-[#d81a48] font-semibold transition-all duration-300 uppercase">
							Annuler
						</a>
						{{ form_row(form.save) }}
					</div>
				</div>

				{{ form_widget(form._token) }}
				{{ form_end(form, { render_rest: false }) }}

				{# Contenu texte du trick #}
				{% include '_partials/trick/details/content.html.twig' %}

				{# Liste des commentaires #}
				{% include '_partials/comment/list.html.twig' %}

			</div>
		</div>
	</section>
{% endblock %}


{% block javascripts %}
	{{ parent() }}
	<script>
		const IMAGE_ROUTES = {
upload: "{{ path('profile_images_temp') }}",
delete: "{{ path('profile_images_temp_delete') }}"
};
	</script>
	<script src="{{ asset('js/media-collapse.js') }}"></script>
	<script src="{{ asset('js/template.js') }}"></script>
	<script src="{{ asset('js/utils.js') }}"></script>
	<script src="{{ asset('js/images.js') }}"></script>
	<script src="{{ asset('js/videos.js') }}"></script>
	<script src="{{ asset('js/load.js') }}"></script>

{% endblock %}
