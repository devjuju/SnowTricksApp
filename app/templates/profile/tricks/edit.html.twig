{% extends 'base.html.twig' %}

{% block title %}Modifier un trick
{% endblock %}

{% block body %}
	<section

		class="relative bg-[#979EAB] pb-12">

		<!-- Hero image -->
		<div class="absolute inset-0">
			<img src="{{ asset('images/backgrounds/image-cover.jpg') }}" alt="Hero" class="w-full h-[400px] sm:h-[500px] md:h-[600px] object-cover brightness-75">
			<div class="absolute inset-0 bg-gradient-to-b from-transparent to-white/80"></div>
		</div>

		<!-- Centered card -->
		<div class="relative z-10 container mx-auto px-4 sm:px-6 md:px-12 lg:px-20 xl:px-32 pt-20 ">
			<div
				class="bg-white rounded-xl shadow-lg max-w-6xl mx-auto overflow-hidden pb-[42px]">


				{# Flash messages #}
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="p-4 mb-4 rounded bg-green-100 text-green-800">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}
				{{ form_start(form, { attr: { novalidate:'novalidate', enctype:'multipart/form-data' } }) }}


				{# Featured image Upload #}

				{# Détermination du chemin de l'image mise en avant à afficher #}
				{% set featuredPath =
                    tempFeaturedImage
                    ? asset('uploads/featured_images_tmp/' ~ tempFeaturedImage)
                    : (trick.featuredImage ? asset('uploads/featured_images/' ~ trick.featuredImage) : null)
                %}

				{# Conteneur featured image #}
					<div
					id="featured-container" data-existing-image="{{ featuredPath ?? '' }}" class="
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	relative
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	w-full
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	min-h-[30vh]
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	sm:min-h-[55vh]
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	md:min-h-[60vh]
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	border-2
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																    flex items-center justify-center
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																															        overflow-hidden"> {# Aperçu image #}
					<img
					id="featured-preview" src="{{ featuredPath }}" class="
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	absolute
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	inset-0
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	w-full
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	h-full
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	object-cover
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	object-center
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	transition-opacity
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	duration-300
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	rounded-t-xl
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																	{{ featuredPath ? '' : 'opacity-0' }}">

					{# Placeholder #}
					<span id="featured-placeholder" class="absolute inset-0 flex items-center justify-center bg-gray-200 {{ featuredPath ? 'opacity-0' : '' }}" style="font-size:24px;">
						<i class="bi bi-person-circle"></i>
					</span>

					{# Overlay texte/hero (facultatif) #}
					<div class="bg-[#00214D]/50 backdrop-blur-sm p-6 md:p-10 rounded-xl max-w-xl text-center pointer-events-none">
						<h1 class="font-[Raleway] text-white font-bold uppercase" style="font-size: clamp(26px, 5vw, 56px)">
							{{ trick.title ?: 'Titre du trick' }}
						</h1>
					</div>

					{# Champ file Symfony #}
					{{ form_widget(form.featuredImage, {
                        attr: {
                            class: 'hidden',
                            accept: 'image/png, image/jpeg, image/webp',
                            id: 'featured-input'
                        }
                    }) }}

					{# Actions Edit/Delete sous le cercle #}
					<div class="absolute top-2 right-2 flex gap-2">
						<button type="button" id="edit-featured" class="p-2 rounded bg-[#2563eb] hover:bg-[#1e40af] text-white shadow-lg">
							<i class="bi bi-pencil-fill"></i>
							<span class="sr-only">Edit</span>
						</button>
						<button type="button" id="delete-featured" class="p-2 rounded bg-[#f8285a] text-white hover:bg-[#d81a48] shadow-lg">
							<i class="bi bi-trash3-fill"></i>
							<span class="sr-only">Delete</span>
						</button>
					</div>
					{# Champ caché suppression (backend) #}
					{{ form_widget(form.deleteFeaturedImage) }}
				</div>

				{# Erreur validation #}
				<div id="featured-error" class="text-red-500 text-sm px-4 md:px-8 lg:px-8 mt-4">{{ form_errors(form.featuredImage) }}</div>

				{% set hasImages = trick.images|length > 0 %}
				{% set hasVideos = trick.videos|length > 0 %}
				{% set hasMedias = hasImages or hasVideos %}

				{% if hasMedias %}
					{# ----- BOUTON COLLAPSE UNIQUE MOBILE ----- #}
					<div class="md:hidden mt-6 px-4 mb-6">
						<button type="button" class="w-full flex justify-between items-center px-4 py-3 bg-gray-100 rounded-lg font-medium" data-collapse-toggle="media-collapse">
							<span>Médias</span>
							<i class="bi bi-chevron-down transition-transform"></i>
						</button>
					</div>
				{% endif %}

				{% if hasMedias %}
					{# ------ WRAPPER COLLAPSE / GRILLE ----- #}
					<div id="media-collapse" class="hidden md:block">
						<div
							class="grid md:grid-cols-2 gap-8 px-4 md:px-8 lg:px-8 mt-4 mb-4 ">

							{# ============== IMAGES ============= #}

							<div class="relative">


								<div
									id="image-wrapper" data-index="{{ form.images|length }}" class="
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										grid
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										grid-cols-1
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										gap-6
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									    md:flex
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										md:flex-row
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										md:gap-4
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																						                md:overflow-x-auto
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										md:scroll-smooth
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																										md:snap-x md:snap-mandatory">

									{# Images existantes #}
									{% for imageForm in form.images %}
										{% if imageForm.vars.data.picture %}
											<div class="media-item media-image relative w-full md:w-40 md:flex-shrink-0 md:snap-start">
												<div class="mb-3 w-full aspect-video rounded overflow-hidden border relative">
													{% if imageForm.vars.data.picture %}
														<img src="{{ asset('uploads/images/' ~ imageForm.vars.data.picture) }}" class="image-preview w-full h-full object-cover" data-filename="{{ imageForm.vars.data.picture }}">
													{% else %}
														<img class="image-preview hidden w-full h-full object-cover">
													{% endif %}
													<div class="image-placeholder absolute inset-0 bg-gray-100 flex items-center justify-center rounded border {{ imageForm.vars.data.picture ? 'hidden' : '' }}">
														<i class="bi bi-image text-2xl text-gray-400"></i>
													</div>
												</div>

												<input type="hidden" class="uploaded-filename" name="images_filenames[]" value="{{ imageForm.vars.data.picture }}">
												<input type="hidden" class="removed-image" name="removed_images[]">

												<div class="media-actions flex justify-end gap-2 mt-2">
													<div class="flex flex-row-reverse items-center gap-2">
														<button type="button" class="remove-item p-2 rounded bg-[#f8285a] text-white hover:bg-[#d81a48] hover:border-[#d81a48]">
															<i class="bi bi-trash3-fill"></i>
															<span class="sr-only">Remove</span>
														</button>

														<button type="button" class="item-add p-2 rounded border border-[#2563eb] bg-[#2563eb] text-white hover:bg-[#1e40af] hover:text-white transition">
															<i class="bi bi-pencil-fill"></i>
															<span class="sr-only">Add</span>
														</button>

														<button type="button" class="item-edit p-2 rounded border border-[#2563eb] text-white hover:bg-[#1f40ae] hover:text-white transition hidden bg-[#2563eb] hover:border-[#1f40ae]">
															<i class="bi bi-pencil-fill"></i>
															<span class="sr-only">Edit</span>
														</button>

														<button type="button" class="item-close hidden p-2 rounded border border-[#f6c000] text-[#f6c000]">
															<i class="bi bi-eye-slash-fill"></i>
															<span class="sr-only">Close</span>
														</button>

														{{ form_widget(imageForm.file, {attr:{class:'item-input w-0 opacity-0 transition-all duration-300'}}) }}
													</div>
												</div>
											</div>
										{% endif %}
									{% endfor %}


								</div>
								<hr class="border-0 h-px bg-blue-100 mt-4 mb-4">

							</div>

							{# ========== VIDEOS =========== #}
							<div class="relative">

								<div id="video-wrapper" class="
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									grid
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									grid-cols-1
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									gap-6
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									md:flex
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									md:flex-row
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									md:gap-4
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									md:overflow-x-auto
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									md:scroll-smooth
																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																																									md:snap-x md:snap-mandatory">

									{% for videoForm in form.videos %}
										<div class="media-item media-video relative w-full md:w-40 md:flex-shrink-0 md:snap-start">
											<div class="mb-3 w-full aspect-video rounded border relative">
												<iframe src="{{ videoForm.vars.data.getEmbedUrl()|default('') }}" class="w-full h-full rounded border"></iframe>
												<div class="video-placeholder absolute inset-0 bg-gray-100 flex items-center justify-center rounded border {{ videoForm.vars.data.getEmbedUrl() ? 'hidden' : '' }}">
													<i class="bi bi-play-btn text-3xl text-gray-400"></i>
												</div>
											</div>

											<input type="hidden" class="removed-video" name="removed_videos[]">

											<div class="media-actions flex justify-end gap-2 mt-2">
												<div class="flex flex-row-reverse items-center gap-2">
													<button type="button" class="remove-item p-2 rounded bg-[#f8285a] text-white hover:bg-[#d81a48] hover:border-[#d81a48]">
														<i class="bi bi-trash3-fill"></i>
														<span class="sr-only">Remove</span>
													</button>

													<button type="button" class="item-add p-2 rounded border bg-[#2563eb] hover:bg-[#1f40ae]">
														<i class="bi bi-pencil-fill"></i>
														<span class="sr-only">Add</span>
													</button>

													<button type="button" class="item-edit hidden p-2 rounded bg-[#2563eb] hover:bg-[#1f40ae] text-white">
														<i class="bi bi-pencil-fill"></i>
														<span class="sr-only">Edit</span>
													</button>

													<button type="button" class="item-close hidden p-2 rounded border border-[#f6c000] text-[#f6c000]">
														<i class="bi bi-eye-slash-fill"></i>
														<span class="sr-only">Close</span>
													</button>

													{{ form_widget(videoForm.url, {attr:{class:'item-input w-0 opacity-0 transition-all duration-300'}}) }}
												</div>
											</div>
										</div>
									{% endfor %}

								</div>
								<hr class="border-0 h-px bg-blue-100 mt-4 mb-4">

							</div>

						</div>
					</div>
				{% endif %}

				<!-- Title, Content, Category -->
				<div class="px-4 md:px-8 lg:px-24 mt-8">
					<div class="mb-4">
						{{ form_widget(form.title, {
                            attr: {
                                class: 'w-full rounded-xl border border-[#1b84ff]  bg-[white] px-4 py-2',
                            }
                        }) }}
						<div class="text-[#d81a48] text-sm">{{ form_errors(form.title) }}</div>
					</div>
					<div class="mb-4">
						{{ form_widget(form.content, {
                            attr: {
                                class: 'w-full h-28 sm:h-36 rounded-xl border border-[#1b84ff]  bg-white px-4 py-2 ',
                            }
                        }) }}
						<div class="text-[#d81a48] text-sm">{{ form_errors(form.content) }}</div>
					</div>
					<div class="mb-4">
						{{ form_widget(form.category, {
                            attr: {
                                class: ' rounded-xl border border-[#1b84ff]  bg-white px-4 py-2  px-4 pr-10 py-2 ',
                            }
                        }) }}
						<div class="text-[#d81a48] text-sm">{{ form_errors(form.category) }}</div>
					</div>
					<div class="flex items-center justify-start gap-2 ">
						<h3 class="text-sm font-medium text-gray-600 mb-2 ">
							Images ({{ form.images|length }})
						</h3>

						<h3 class="text-sm font-medium text-gray-600 mb-2 ">
							Vidéos ({{ form.videos|length }})
						</h3>
					</div>


					<div class="flex flex-col justify-end md:flex-row md:justify-end mt-4 gap-4">


						{% if trick.images|length == 0 and trick.videos|length == 0 %}
							<a href="{{ path('app_profile_add_medias_trick', {slug: trick.slug}) }}" class=" bg-blue-100 text-blue-600 px-6 py-3 rounded-2xl hover:bg-[#056ee9] hover:text-white font-semibold transition-all duration-300 uppercase">
								Ajouter des médias
							</a>
						{% endif %}

						{{ form_row(form.delete) }}
						{{ form_row(form.save) }}
					</div>
					{# Token CSRF #}
					{{ form_widget(form._token) }}
					{{ form_end(form, { render_rest: false }) }}
				</div>
			</div>
		</section>

	{% endblock %}

	{% block javascripts %}
		{{ parent() }}
		<script>
			const IMAGE_ROUTES = {
upload: "{{ path('profile_images_temp') }}",
delete: "{{ path('profile_images_temp_delete') }}"
};
		</script>
		<script src="{{ asset('js/featured-image.js') }}"></script>
		<script src="{{ asset('js/media-collapse.js') }}"></script>
		<script src="{{ asset('js/utils.js') }}"></script>
		<script src="{{ asset('js/template.js') }}"></script>
		<script src="{{ asset('js/images.js') }}"></script>
		<script src="{{ asset('js/videos.js') }}"></script>
	{% endblock %}
