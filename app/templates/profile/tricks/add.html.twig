{% extends 'base.html.twig' %}

{% block title %}Ajouter un trick
{% endblock %}

{% block body %}
	<section
		class="relative bg-[#979EAB] pb-12">

		{# === Hero de la page === #}
		{% include '_partials/trick/hero.html.twig' %}

		<div
			class="relative z-10 container mx-auto px-4 sm:px-6 md:px-12 lg:px-20 xl:px-32 pt-20 ">
			{# === Conteneur principal du formulaire === #}
			<div
				class="bg-white rounded-xl shadow-lg max-w-6xl mx-auto overflow-hidden pb-[42px]">

				{# === Messages flash (succès, erreur, etc.) === #}
				{% for message in app.flashes('error') %}
					<div class="alert alert-danger">
						{{ message }}
					</div>
				{% endfor %}

				{{ form_start(form, { attr: { novalidate:'novalidate', enctype:'multipart/form-data' } }) }}

				{# Image principale (upload + preview) #}
				{% include '_partials/trick/add/featured_image.html.twig' %}

				{# Gestion des médias (images + vidéos dynamiques) #}
				{% include '_partials/trick/add/media.html.twig' %}

				{# Champs du formulaire (titre, description, catégorie, etc.) #}
				{% include '_partials/trick/add/form_fields.html.twig' %}

				{{ form_widget(form._token) }}
				{{ form_end(form, { render_rest: false }) }}
			</section>
		{% endblock %}

		{% block javascripts %}
			{{ parent() }}
			<script>
				const IMAGE_ROUTES = {
upload: "{{ path('profile_images_temp') }}",
delete: "{{ path('profile_images_temp_delete') }}"
};
			</script>
			<script src="{{ asset('js/featured-image.js') }}"></script>
			<script src="{{ asset('js/media-collapse.js') }}"></script>
			<script src="{{ asset('js/utils.js') }}"></script>
			<script src="{{ asset('js/template.js') }}"></script>
			<script src="{{ asset('js/images.js') }}"></script>
			<script src="{{ asset('js/videos.js') }}"></script>
		{% endblock %}
