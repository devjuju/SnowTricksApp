{% extends 'base.html.twig' %}

{% block title %}Profil de
	{{ app.user.username }}
{% endblock %}

{% block body %}

	<!-- HERO -->
	<section id="hero" class="relative px-6 md:px-[93px]
		    bg-[#D3DCEB]
		    pt-[120px] pb-[42px]
		    bg-cover bg-center bg-no-repeat
		    h-[350px] sm:h-[450px] md:min-h-[calc(100vh-80px)]
		    flex items-center md:justify-center" style="background-image: url('{{ asset('images/backgrounds/image-cover.jpg') }}')">

		<div class="w-full flex justify-center">
			<div class="bg-[#00214D]/50 backdrop-blur-sm p-6 md:p-10 rounded-xl max-w-xl">

				<div class="flex gap-4 py-4 border-b">
					{% if app.user.avatar %}
						<img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" class="w-20 h-20 rounded-full object-cover">
					{% else %}
						<div class="w-20 h-20 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold text-xl">
							{{ app.user.username|first|upper }}
						</div>
					{% endif %}

					<div class="flex-1 p-4">
						<strong class="text-white md:text-lg">
							{{ app.user.username|capitalize }}
						</strong>
						<p class="text-white">{{ app.user.email }}</p>
					</div>
				</div>

				<h1 class="font-[Raleway] text-white font-bold uppercase mb-4" style="font-size: clamp(26px, 5vw, 56px)">
					Bienvenue sur SnowTricks
				</h1>

				<p class="text-white text-base md:text-lg">
					Découvrez et partagez des figures de snowboard avec notre communauté.
				</p>

				<br>

				<a href="{{ path('app_profile_edit') }}" class="bg-blue-600 text-white px-6 py-3 rounded-2xl hover:bg-blue-800 font-semibold transition">
					Modifier votre profil
				</a>

			</div>
		</div>

	</section>


	<!-- TRICKS -->
	<section id="tricks-section" class="px-6 md:px-[93px] bg-[#D3DCEB] pt-[60px] pb-[42px]">

		<div id="tricks-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-5 gap-6">

			{% include '_partials/tricks.html.twig' with { tricks: tricks } %}

		</div>

	</section>


	<!-- FLOATING SCROLL DOCK -->
	<div
		id="scroll-dock" class="fixed right-6 bottom-8 flex flex-col gap-3 z-[60]">

		<!-- SCROLL DOWN -->
		<div class="relative group">
			<button id="scroll-down" class="bg-white/70 dark:bg-gray-800/70
					            p-4 rounded-full shadow-lg
					            hover:scale-110 transition-all duration-300
					            animate-[floatDown_2s_ease-in-out_infinite]">

				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
				</svg>

			</button>

			<span class="absolute right-full mr-3 top-1/2 -translate-y-1/2
					            bg-black text-white text-xs px-2 py-1 rounded
					            opacity-0 group-hover:opacity-100 transition">
				Descendre
			</span>
		</div>


		<!-- SCROLL TOP -->
		<div class="relative group">
			<button id="scroll-top" class="bg-white/70 dark:bg-gray-800/70
					            p-4 rounded-full shadow-lg
					            hover:scale-110 transition-all duration-300
					            opacity-0 translate-y-4 pointer-events-none">

				<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
				</svg>

			</button>

			<span class="absolute right-full mr-3 top-1/2 -translate-y-1/2
					            bg-black text-white text-xs px-2 py-1 rounded
					            opacity-0 group-hover:opacity-100 transition">
				Haut
			</span>
		</div>

	</div>

{% endblock %}


{% block javascripts %}
	{{ parent() }}

	<script>
		document.addEventListener('DOMContentLoaded', () => {

const scrollTopBtn = document.getElementById('scroll-top');
const scrollDownBtn = document.getElementById('scroll-down');
const hero = document.getElementById('hero');
const tricksSection = document.getElementById('tricks-section');

scrollDownBtn.addEventListener('click', () => {
tricksSection.scrollIntoView({behavior: 'smooth'});
});

scrollTopBtn.addEventListener('click', () => {
window.scrollTo({top: 0, behavior: 'smooth'});
});

function toggle(btn, show) {
btn.classList.toggle('opacity-0', ! show);
btn.classList.toggle('translate-y-4', ! show);
btn.classList.toggle('pointer-events-none', ! show);
}

window.addEventListener('scroll', () => {

const scrollY = window.scrollY;
const heroBottom = hero.offsetTop + hero.offsetHeight;

toggle(scrollDownBtn, scrollY < heroBottom - 50);
toggle(scrollTopBtn, scrollY > heroBottom);

});

});
	</script>

{% endblock %}
