{% extends 'base.html.twig' %}

{% block title %}Profil de
	{{ app.user.username }}
{% endblock %}

{% block body %}

	{# === Section Hero (classes) === #}
	{% set sectionHeroClass = "relative px-6 sm:px-0 md:px-[93px] bg-[#D3DCEB]
    pt-[120px] pb-[42px] bg-cover bg-center bg-no-repeat
    min-h-screen flex items-center" %}

	{# === Section Hero (bannière profil utilisateur) === #}
	<section
		class="{{ sectionHeroClass }}" style="background-image: url('{{ asset('images/backgrounds/image-cover.jpg') }}')">
		{# === Bloc profil utilisateur (avatar + infos) === #}
		{% include '_partials/profile/bloc.html.twig' %}
	</section>

	{# === Liste des tricks de l'utilisateur === #}
	{% include '_partials/profile/tricks/section.html.twig' %}

	{# === Bouton / logique scroll to top === #}
	{% include '_partials/scroll.html.twig' %}

{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{# === Scripts liés au profil (scroll + chargement dynamique) === #}
	<script src="{{ asset('js/scroll.js') }}"></script>
	<script src="{{ asset('js/load.js') }}"></script>
{% endblock %}
