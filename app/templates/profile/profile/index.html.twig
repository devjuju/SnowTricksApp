{% extends 'base.html.twig' %}

{% block title %}Profil de
	{{ app.user.username }}
{% endblock %}

{% block body %}
	{% set sectionHeroClass = "relative px-6 sm:px-0 md:px-[93px] bg-[#D3DCEB]
	pt-[120px] pb-[42px] bg-cover bg-center bg-no-repeat
	min-h-screen flex items-center" %}

	<!-- Section Hero  -->
	<section class="{{ sectionHeroClass }}" style="background-image: url('{{ asset('images/backgrounds/image-cover.jpg') }}')">

		<div class="w-full flex justify-center">
			<div class="bg-[#00214D]/50 backdrop-blur-sm p-6 md:p-10 rounded-xl max-w-xl">
				<div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 py-4 border-b ">
					{% if app.user.avatar %}
						<img src="{{ asset('uploads/avatars/' ~ app.user.avatar) }}" class="w-14 h-14 sm:w-20 sm:h-20 rounded-full object-cover shrink-0">
					{% else %}
						<div class="w-20 h-20 rounded-full bg-blue-600 flex items-center justify-center text-white font-bold" style="font-size:24px;">
							{{ app.user.username|first|upper }}
						</div>
					{% endif %}

					<div class="flex-1 p-2 sm:p-4 min-w-0 ">
						<strong class="text-white md:text-lg break-words ">
							{{ app.user.username|capitalize }}
						</strong>
						<p class="text-white break-words">{{ app.user.email }}</p>
					</div>
				</div>
				<h1 class="font-[Raleway] text-white font-bold uppercase mb-4" style="font-size: clamp(26px, 5vw, 56px)">
					Bienvenue sur SnowTricks
				</h1>

				<p class="text-white text-base md:text-lg">
					Découvrez et partagez des figures de snowboard avec notre communauté passionnée.
				</p>
				<br>
				<a href="{{ path('app_profile_edit') }}" class="bg-blue-600 text-white px-6 py-3 rounded-2xl hover:bg-blue-800 font-semibold transition-all duration-300 uppercase">
					Editer le profil
				</a>
			</div>

		</div>

	</section>


	<!-- Section Tricks -->
	<section class="px-6 md:px-[93px] bg-[#D3DCEB] pt-[60px] pb-[42px]">
		<div id="tricks-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-5 gap-6">
			{% include '_partials/tricks.html.twig' with { tricks: tricks } %}
		</div>

		<!-- Bouton Load More -->
		<div class="mt-6 flex justify-center">
			<button
				data-load-more data-page="{{ page }}" data-url="{{ path('app_main') }}" data-container="#tricks-container" class="load-more-btn bg-blue-600 text-white px-6 py-3 rounded-2xl hover:bg-blue-800 font-semibold transition-all duration-300 uppercase flex items-center justify-center gap-2 disabled:opacity-70 disabled:cursor-not-allowed">


				<!-- Spinner (caché par défaut) -->
				<svg class="load-spinner hidden w-5 h-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewbox="0 0 24 24">
					<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
					<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
				</svg>
				<span class="load-text">Afficher plus</span>
			</button>
		</div>
	</section>

	{% set scrollDownClass = "fixed right-6 bottom-24 md:bottom-8 z-[60] bg-white/70 dark:bg-gray-800/70 text-black dark:text-white p-4 rounded-full shadow-lg hover:scale-110 transition-transform duration-300 opacity-100 translate-y-0 pointer-events-auto" %}

	<!-- Bouton descendre -->
	<button id="scroll-down" class="{{ scrollDownClass }}">
		<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
		</svg>
	</button>

	{% set scrollTopClass = "fixed right-6 bottom-24 md:bottom-8 z-[60] bg-white/70  dark:bg-gray-800/70 text-black dark:text-white p-4 rounded-full shadow-lg hover:scale-110
	transition-all duration-500 opacity-0 translate-y-10 pointer-events-none" %}

	<!-- Bouton remonter -->
	<button id="scroll-top" class="{{ scrollTopClass }}">
		<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewbox="0 0 24 24" stroke="currentColor">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
		</svg>
	</button>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('js/scroll.js') }}"></script>
	<script src="{{ asset('js/load.js') }}"></script>
{% endblock %}
