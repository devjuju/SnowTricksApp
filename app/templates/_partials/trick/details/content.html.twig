<div class="px-4 md:px-8 lg:px-16">

	<p>{{ trick.content }}</p>

	<hr
	class="border-0 h-px bg-gray-300 my-8">

	{# Meta informations #}
	<div
		class="flex flex-col md:flex-row items-center justify-center gap-4 text-gray-500 mb-6">

		{# Catégorie #}
		<div class="flex items-center border-r pr-4">
			<span class="inline-block bg-blue-100 text-blue-600 text-sm font-semibold px-3 py-1">
				{{ trick.category ? trick.category.name : 'Aucune catégorie' }}
			</span>
		</div>

		{# Date création / modification #}
		<div class="flex items-center border-r pr-4">
			<div class="text-sm text-gray-500">
				{% if trick.updatedAt %}
					Modifié le
					{{ trick.updatedAt|date('d/m/Y') }}
				{% else %}
					Créé le
					{{ trick.createdAt|date('d/m/Y') }}
				{% endif %}
			</div>
		</div>

	</div>

	<hr class="border-0 h-px bg-gray-300 my-8">
</div>
