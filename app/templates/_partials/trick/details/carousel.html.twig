<div class="md:hidden mt-6 px-4 mb-6">

	<button type="button" class="w-full flex justify-between items-center px-4 py-3 bg-gray-100 rounded-lg font-medium" data-collapse-toggle="media-collapse-mobile">
		<span>Médias</span>
		<i class="bi bi-chevron-down transition-transform"></i>
	</button>
</div>

<div
	id="media-collapse-mobile" class="hidden md:hidden px-4 mt-4 space-y-4 mb-6">

	{# Images (mobile) #}
	{% for image in trick.images %}
		<div class="w-full aspect-video rounded overflow-hidden border">
			<img src="{{ asset('uploads/images/' ~ image.picture) }}" class="w-full h-full object-cover">
		</div>
	{% endfor %}

	{# Vidéos (mobile) #}
	{% for video in trick.videos %}
		<div class="w-full aspect-video rounded border">
			<iframe src="{{ video.getEmbedUrl() }}" class="w-full h-full rounded border" frameborder="0" allowfullscreen></iframe>
		</div>
	{% endfor %}
</div>

<div class="hidden md:flex relative w-full px-4 md:px-8 overflow-hidden mt-8">

	<div
		id="media-wrapper" class="flex gap-4 overflow-x-auto scroll-smooth snap-x snap-mandatory">

		{# Images #}
		{% for image in trick.images %}
			{% if image.picture %}
				<div class="media-item media-image flex-shrink-0 w-40 snap-start">
					<div class="mb-3 w-full aspect-video rounded overflow-hidden border">
						<img src="{{ asset('uploads/images/' ~ image.picture) }}" class="w-full h-full object-cover">
					</div>
				</div>
			{% endif %}
		{% endfor %}

		{# Vidéos #}
		{% for video in trick.videos %}
			<div class="media-item media-video flex-shrink-0 w-40 snap-start">
				<div class="video-container mb-3 w-full aspect-video rounded border">
					<iframe src="{{ video.getEmbedUrl() }}" class="w-full h-full rounded border" frameborder="0" allowfullscreen></iframe>
				</div>
			</div>
		{% endfor %}
	</div>
</div>
