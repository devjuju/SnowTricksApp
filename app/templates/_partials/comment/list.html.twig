<!-- Comment List -->
<div class="w-full max-w-xl mx-auto bg-white p-4 rounded-lg mt-6">
	<h2 class="font-[Raleway] text-2xl font-bold mb-6">Commentaires ({{ trick.comments|length }})</h2>
	<div id="comments-container" class="space-y-4 ">
		{% include '_partials/comment/item.html.twig' with { comments: comments } %}
	</div>

	<!-- Bouton Load More -->
	{% if totalComments > limit %}
		<div class="text-center mt-6">
			<button id="load-more-comments" data-load-more data-container="#comments-container" data-url="{{ path('app_tricks_details', { slug: trick.slug }) }}" data-page="{{ page }}" class="bg-blue-600 text-white px-6 py-3 rounded-2xl hover:bg-blue-800 font-semibold transition-all duration-300 uppercase">
				<span class="load-text">Afficher plus</span>
			</button>
		</div>
	{% endif %}
</div>
