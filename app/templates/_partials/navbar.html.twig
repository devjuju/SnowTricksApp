{% set mobileMenuClass = "hidden lg:flex lg:w-auto lg:order-3 items-center justify-end bg-white lg:bg-transparent transition-colors duration-300 lg:shadow-none" %}

{% set currentRoute = app.request.attributes.get('_route') %}

{% set linkBase = "menu-link block py-2 pl-3 pr-4 text-[#001236] lg:text-white hover:underline" %}
{% set linkActive = "text-blue-600" %}
{% set linkInactive = "text-blue-400 opacity-60" %}

{% if not app.user %}
	<header id="main-header" class="fixed top-0 z-40 w-full pb-5 pt-5 bg-transparent transition-colors duration-300 hidden md:block">
		<nav class="w-full border-gray-200 py-2.5 uppercase">
			<div
				class="flex flex-wrap items-center justify-between w-full px-4">

				<!-- LOGO -->
				<a href="{{ path('app_main') }}" class="flex items-center">
					<img src="{{ asset('images/logos/logo-snowtricks-favicon.svg') }}" class="h-6 mr-3 sm:h-9" alt="SnowTricks Logo">
					<span id="logo-text" class="font-[Raleway] self-center text-xl font-semibold text-white">SnowTricks</span>
				</a>

				<!-- BOUTON MOBILE -->
				<div class="flex items-center space-x-4 lg:space-x-6 lg:order-2">
					<button id="mobile-btn" data-collapse-toggle="mobile-menu-2" type="button" class="inline-flex items-center p-2 text-white rounded-lg lg:hidden hover:bg-[#26679c] focus:outline-none focus:ring-2 focus:ring-gray-100" aria-controls="mobile-menu-2" aria-expanded="false">
						<span class="sr-only">Open main menu</span>
						<svg class="w-6 h-6" fill="currentColor" viewbox="0 0 20 20">
							<path fill-rule="evenodd" d="M3 5h14a1 1 0 010 2H3a1 1 0 010-2zm0 5h14a1 1 0 010 2H3a1 1 0 010-2zm0 5h14a1 1 0 010 2H3a1 1 0 010-2z" clip-rule="evenodd"></path>
						</svg>
					</button>
				</div>


				<!-- MENU DE NAVIGATION -->
				<div id="mobile-menu-2" class="{{ mobileMenuClass }}">
					<ul class="flex flex-col mt-4 font-medium lg:flex-row lg:mt-0">
						<li class="lg:border-r lg:border-gray-300 lg:pr-4">
							<a href="{{ path('app_main') }}" class="{{ linkBase ~ ' ' ~ (currentRoute == 'app_main' ? linkActive : linkInactive) }}">
								Accueil
							</a>
						</li>

						<li class="lg:border-r lg:border-gray-300 lg:px-4">
							<a href="{{ path('app_register') }}" class="{{ linkBase ~ ' ' ~ (currentRoute == 'app_register' ? linkActive : linkInactive) }}">
								S'inscrire
							</a>
						</li>

						<li class="lg:pl-4">
							<a href="{{ path('app_login') }}" class="{{ linkBase ~ ' ' ~ (currentRoute == 'app_login' ? linkActive : linkInactive) }}">
								Se connecter
							</a>
						</li>
					</ul>
				</div>

			</div>
		</nav>
	</header>
{% else %}
	<header id="main-header" class="fixed top-0 z-20 w-full pb-5 pt-5 bg-transparent transition-colors duration-300 hidden md:block">
		<nav class="w-full border-gray-200 py-2.5 uppercase">
			<div
				class="flex flex-wrap items-center justify-between w-full px-4">

				<!-- LOGO -->
				<a href="{{ path('app_profile_index') }}" class="flex items-center">
					<img src="{{asset('images/logos/logo-snowtricks-favicon.svg')}}" class="h-6 mr-3 sm:h-9" alt="SnowTricks Logo">
					<span id="logo-text" class="font-[Raleway] self-center text-xl font-semibold text-white">SnowTricks</span>
				</a>

				<!-- BOUTON MOBILE -->
				<div class="flex items-center space-x-4 lg:space-x-6 lg:order-2">
					<button id="mobile-btn" data-collapse-toggle="mobile-menu-2" type="button" class="inline-flex items-center p-2 text-white rounded-lg lg:hidden hover:bg-[#26679c] focus:outline-none focus:ring-2 focus:ring-gray-100" aria-controls="mobile-menu-2" aria-expanded="false">
						<span class="sr-only">Open main menu</span>
						<svg class="w-6 h-6" fill="currentColor" viewbox="0 0 20 20">
							<path fill-rule="evenodd" d="M3 5h14a1 1 0 010 2H3a1 1 0 010-2zm0 5h14a1 1 0 010 2H3a1 1 0 010-2zm0 5h14a1 1 0 010 2H3a1 1 0 010-2z" clip-rule="evenodd"></path>
						</svg>
					</button>
				</div>

				<!-- MENU DE NAVIGATION -->
				<div id="mobile-menu-2" class="{{ mobileMenuClass }}">
					<ul class="flex flex-col mt-4 font-medium lg:flex-row lg:mt-0">
						<li class="lg:border-r lg:border-gray-300 lg:pr-4">
							<a href="{{ path('app_profile_index') }}" class="{{ linkBase ~ ' ' ~ (currentRoute == 'app_profile_index' ? linkActive : linkInactive) }}">
								Accueil
							</a>
						</li>

						<li class="lg:border-r lg:border-gray-300 lg:px-4">
							<a href="{{ path('app_profile_tricks_add') }}" class="{{ linkBase ~ ' ' ~ (currentRoute == 'app_profile_tricks_add' ? linkActive : linkInactive) }}">
								Ajouter une figure
							</a>
						</li>

						<li class="lg:pl-4">
							<a href="{{ path('app_logout') }}" class="menu-link block py-2 pl-3 pr-4 text-blue-400 opacity-60 lg:text-white hover:underline">
								Se déconnecter
							</a>
						</li>
					</ul>
				</div>
			</div>
		</nav>
	</header>
{% endif %}
